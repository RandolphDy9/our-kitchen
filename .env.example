# Leave these blank to run in local demo mode (data lives in this browser only).
# Supabase dashboard → Project Settings → API (or "Connect"): project URL + publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# The super admin. Signing in with this email (and its password) unlocks the "Admins" screen.
# Must match the email in supabase/schema.sql.
NEXT_PUBLIC_OWNER_EMAIL=

# How the super admin is shown on the Admins screen.
NEXT_PUBLIC_OWNER_NAME=
